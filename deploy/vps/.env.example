# Copy to .env and replace every placeholder before starting. Never commit .env.
POSTGRES_DB=ifa
POSTGRES_USER=ifa_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
API_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REST_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgres://ifa_api:REPLACE_API_DB_PASSWORD@db:5432/ifa
MIGRATE_DATABASE_URL=postgres://ifa_admin:REPLACE_POSTGRES_PASSWORD@db:5432/ifa
DATA_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
NODE_ENV=production
PORT=8787
API_URL=https://ifa.ng
APP_URL=https://ifa.ng
CORS_ORIGINS=https://ifa.ng,https://www.ifa.ng
COOKIE_DOMAIN=ifa.ng
S3_ENDPOINT=http://ai20-minio:9000
S3_BUCKET=ifa-files
S3_ACCESS_KEY_ID=REPLACE_WITH_RANDOM_SECRET
S3_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET
FILES_DIR=/data/files
# Proxies in front of the API that append to X-Forwarded-For. nginx passes Traefik's header through, so 1.
TRUSTED_PROXY_HOPS=1

# Backups (backup service). Dumps are kept on the server for BACKUP_KEEP_LOCAL days.
# Strongly recommended: copy them off the server too, e.g. to a Cloudflare R2 or Backblaze bucket:
#   RCLONE_REMOTE=offsite:ifa-backups  BACKUP_S3_PROVIDER=Cloudflare  BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_HOUR=2
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_REMOTE=30
RCLONE_REMOTE=
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Error tracking (optional). Server errors go to Sentry when set.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Help page and footer contact (web build).
VITE_SUPPORT_EMAIL=support@ifa.ng
VITE_SUPPORT_WHATSAPP=
