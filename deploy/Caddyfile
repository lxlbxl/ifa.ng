# Caddy gets and renews the TLS certificate automatically.
{$API_DOMAIN} {
	encode gzip
	handle_path /rest/v1/* {
		reverse_proxy postgrest:3000
	}
	handle {
		reverse_proxy api:8787
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stdout
		format json
	}
}
