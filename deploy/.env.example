# Copy to deploy/.env on the server. Never commit the real file.
# Generate passwords with: openssl rand -base64 32 | tr -d '/+='

API_DOMAIN=api.ifa.ng
CORS_ORIGINS=https://ifa.ng,https://www.ifa.ng
APP_URL=https://ifa.ng

# Login. AUTH_SECRET signs sessions: generate with openssl rand -base64 48.
AUTH_SECRET=
# Signs the short tokens the web app sends to PostgREST. Generate the same way.
DATA_JWT_SECRET=
# Share the login cookie between ifa.ng and api.ifa.ng.
COOKIE_DOMAIN=ifa.ng
# Verification and password-reset emails, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=IFA.ng <no-reply@ifa.ng>

DB_ADMIN_PASSWORD=change-me
API_DB_PASSWORD=change-me-too
REST_DB_PASSWORD=change-me-three

# Payments. Webhook URLs to set in the dashboards:
#   Paystack:    https://api.ifa.ng/webhooks/paystack
#   Flutterwave: https://api.ifa.ng/webhooks/flutterwave (and set its "secret hash" to FLW_SECRET_HASH)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_SECRET_HASH=

# Google Meet: service account JSON (or its base64) with domain-wide delegation, acting as this Workspace user.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ORGANIZER_EMAIL=meet@ifa.ng

# Agora video fallback.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# WhatsApp (Meta Cloud API) first, SMS through Termii as the fallback.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TERMII_API_KEY=
TERMII_SENDER_ID=IFA

# Files (profile photos, session audio): a PRIVATE R2 bucket, separate from backups.
# Leave empty to keep files on the server's disk (the 'files' volume) instead.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=ifa-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Recording worker: speech to text and notes drafting.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Offsite backups (Cloudflare R2 shown; any S3-compatible bucket works).
BACKUP_HOUR=2
RCLONE_REMOTE=r2:ifa-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
