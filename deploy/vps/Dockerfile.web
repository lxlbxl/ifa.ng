FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_SENTRY_DSN=
ARG VITE_SUPPORT_EMAIL=support@ifa.ng
ARG VITE_SUPPORT_WHATSAPP=
ENV VITE_API_URL=https://ifa.ng VITE_APP_ENV=production VITE_ENABLE_MOCK_DATA=false \
    VITE_SENTRY_DSN=$VITE_SENTRY_DSN VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL VITE_SUPPORT_WHATSAPP=$VITE_SUPPORT_WHATSAPP
RUN npm run build
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/vps/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/vps/security-headers.conf /etc/nginx/snippets/security-headers.conf
